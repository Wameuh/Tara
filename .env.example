# Copy this file to .env, keep it mode 0600, and supply only the values needed
# by the selected deployment mode. Never commit real credentials.
TARA_ADMIN_PASSWORD=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
TARA_INFERENCE_ENDPOINT=http://host.docker.internal:8000
TARA_INFERENCE_AUTH_PROVIDER=none
TARA_TRANSCRIPTION_PARALLELISM=3
TARA_MODAL_PROXY_AUTH_KEY=
TARA_MODAL_PROXY_AUTH_SECRET=
TARA_KOFI_VERIFICATION_TOKEN=
