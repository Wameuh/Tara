services:
  tara-web-migrate:
    secrets: [backup_signing_key, kofi_verification_token]
    environment:
      TARA_WEB_BACKUP_SIGNING_KEY_FILE: /run/secrets/backup_signing_key
      TARA_KOFI_VERIFICATION_TOKEN_FILE: /run/secrets/kofi_verification_token
  tara-web:
    # Install docker/apparmor/tara-cursor-web on Linux hosts before startup.
    security_opt:
      - apparmor=tara_cursor_web
      - seccomp=./docker/seccomp/tara-cursor-web.json
    # The AppArmor profile intentionally permits TCP only; force DNS over TCP.
    dns_opt: [use-vc]
    environment:
      TARA_INFERENCE_ENDPOINT: ${TARA_INFERENCE_ENDPOINT:-http://host.docker.internal:8000}
      TARA_INFERENCE_AUTH_PROVIDER: ${TARA_INFERENCE_AUTH_PROVIDER:-modal_proxy}
      TARA_WEB_BACKUP_SIGNING_KEY_FILE: /run/secrets/backup_signing_key
      TARA_MODAL_PROXY_AUTH_KEY_FILE: /run/secrets/modal_proxy_auth_key
      TARA_MODAL_PROXY_AUTH_SECRET_FILE: /run/secrets/modal_proxy_auth_secret
      TARA_KOFI_VERIFICATION_TOKEN_FILE: /run/secrets/kofi_verification_token
      TARA_CURSOR_AUTH_FILE: /run/secrets/cursor_auth
      PATH: /opt/cursor-agent:/app/.venv/bin:/usr/local/bin:/usr/bin:/bin
    volumes:
      - ${TARA_CURSOR_AGENT_DIR:-./cursor-agent}:/opt/cursor-agent:ro
    secrets:
      - backup_signing_key
      - modal_proxy_auth_key
      - modal_proxy_auth_secret
      - kofi_verification_token
      - cursor_auth
  tara-web-backup:
    secrets: [backup_signing_key, kofi_verification_token]
    environment:
      TARA_WEB_BACKUP_SIGNING_KEY_FILE: /run/secrets/backup_signing_key
      TARA_KOFI_VERIFICATION_TOKEN_FILE: /run/secrets/kofi_verification_token
  tara-web-restore:
    secrets: [backup_signing_key]
    environment:
      TARA_WEB_BACKUP_SIGNING_KEY_FILE: /run/secrets/backup_signing_key

secrets:
  backup_signing_key:
    file: ${TARA_WEB_BACKUP_KEY_FILE:-./secrets/backup-signing-key}
  modal_proxy_auth_key:
    file: ${TARA_MODAL_PROXY_AUTH_KEY_FILE:-./secrets/modal-proxy-auth-key}
  modal_proxy_auth_secret:
    file: ${TARA_MODAL_PROXY_AUTH_SECRET_FILE:-./secrets/modal-proxy-auth-secret}
  kofi_verification_token:
    file: ${TARA_KOFI_VERIFICATION_TOKEN_FILE:-./secrets/kofi-verification-token}
  cursor_auth:
    file: ${TARA_CURSOR_AUTH_FILE:-./secrets/cursor-auth.json}
